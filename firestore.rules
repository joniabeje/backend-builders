rules_version = '2';

// Browsers never read or write Firestore directly. Every request goes through the app
// server, which uses the Admin SDK (that bypasses these rules) and enforces sign-in,
// roles and validation itself. See docs/ARCHITECTURE.md, ADR-1.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
